<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.terreno.piloto" android:versionCode="5" android:versionName="1.4.0-premium-piloto">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
